 // -1 if should not be visible, -2 if bad history()
+QRect HistoryInner::lumenSelectedArea() const {
+	constexpr auto kMaxHeight = 8000;
+	auto top = std::numeric_limits<int>::max();
+	auto bottom = -1;
+	for (const auto &item : _selected) {
+		const auto view = viewByItem(item);
+		const auto viewTop = itemTop(view);
+		if (viewTop < 0) {
+			continue;
+		}
+		top = std::min(top, viewTop);
+		bottom = std::max(bottom, viewTop + view->height());
+	}
+	if (bottom <= top) {
+		return QRect();
+	}
+	return QRect(0, top, width(), std::min(bottom - top, kMaxHeight));
+}
+
