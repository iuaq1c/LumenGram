diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 70c567d..3683822 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -4,6 +4,9 @@ apply plugin: 'com.android.library'
 apply plugin: 'org.telegram.build-plugin'
 apply plugin: 'idea'
 
+def lumenApiId = (System.getenv("LUMEN_API_ID") ?: "").trim()
+def lumenApiHash = (System.getenv("LUMEN_API_HASH") ?: "").trim()
+
 idea {
     module {
         excludeDirs += [
@@ -142,6 +145,10 @@ android {
 
         multiDexEnabled true
 
+        // LumenGram: own api_id/api_hash come from the environment (D:\TBuild\lumen_api.bat), never from the sources.
+        buildConfigField "int", "LUMEN_API_ID", lumenApiId.isEmpty() ? "0" : lumenApiId
+        buildConfigField "String", "LUMEN_API_HASH", "\"" + lumenApiHash + "\""
+
         externalNativeBuild {
             cmake {
                 version '3.22.1'
@@ -245,7 +252,7 @@ def getProps(String propName) {
         return "";
     }
 }
-apply plugin: 'com.google.gms.google-services'
+// LumenGram: no google-services plugin, it would ship Telegram's own Firebase keys.
 
 task checkVisibility {
     doFirst {
@@ -268,3 +275,13 @@ task checkVisibility {
 }
 
 preBuild.dependsOn checkVisibility
+
+task checkLumenApiKeys {
+    doFirst {
+        if (lumenApiId.isEmpty() || lumenApiHash.isEmpty()) {
+            throw new GradleException("LUMEN_API_ID / LUMEN_API_HASH are not set: run D:\\TBuild\\lumen_api.bat first")
+        }
+    }
+}
+
+preBuild.dependsOn checkLumenApiKeys
